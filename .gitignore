*.ogw
*.ojw
*.opw
*.res
*.resb
*.rtt
*.stf
*.sto
result_*.vtp

# Local tooling
.pytest_cache/
__pycache__/
*.pyc
.venv/
.vscode/
.idea/
.ccg/
runs/

# Keep intentional empty legacy input fixtures
!cases/**/*.aqu
!cases/**/*.ftr
!cases/**/*.ifs
!cases/**/*.nrt
!cases/**/*.tem

