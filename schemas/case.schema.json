{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hstar.local/schemas/case.schema.json",
  "title": "hstarYLNext authoring input",
  "description": "Bootstrap schema. No solver capability is implied until M5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case", "model", "analysis"],
  "properties": {
    "version": {
      "const": 1
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mesh", "units"],
      "properties": {
        "mesh": { "type": "string", "minLength": 1 },
        "units": { "enum": ["SI"] }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["static"] }
      }
    }
  }
}

